# API 서버 주소 (클라이언트에 공개되는 값만 사용)
EXPO_PUBLIC_API_URL=

# 팀 검토 전용 빌드에서만 true. 정식 서비스에서는 설정하지 않습니다.
EXPO_PUBLIC_TEAM_REVIEW=false

# 카카오톡 공유용 JavaScript 키 (비밀 키가 아닌 웹 공개 키)
EXPO_PUBLIC_KAKAO_JAVASCRIPT_KEY=

# 학부모 /l/{token}/reports/{id}, /l/{token}/invoices/{id} 화면 연결 후에만 true
EXPO_PUBLIC_PARENT_LINKS_READY=false
